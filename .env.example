# Adzuna (developer.adzuna.com/signup)
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Gmail App Password (myaccount.google.com/apppasswords)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
RECIPIENT_EMAIL=your_email@gmail.com

# Groq (console.groq.com/keys) - free tier, powers the CrewAI agents
# using OpenAI's open-weight gpt-oss models served by Groq (not the paid OpenAI API)
GROQ_API_KEY=your_groq_key_here
